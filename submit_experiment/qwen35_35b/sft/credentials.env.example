# Required unless the submit shell already exports AREAL_DIR.
# Use a literal path; relative paths resolve from this credentials.env directory.
export AREAL_DIR='/absolute/path/to/AReaL'

# Optional W&B credentials. Arena credentials are not needed for SFT.
# Copy to credentials.env (ignored by git), or use ../credentials.env.
export WANDB_API_KEY=''
export WANDB_BASE_URL=''
