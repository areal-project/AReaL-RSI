# Interaction, RSI and Research Agents: Responses API with tool calling.
RSI_BASE_URL=https://api.openai.com
RSI_API_KEY=
RSI_MODEL=gpt-5.5
RSI_REASONING_EFFORT=high
RSI_DATA_ROOT=.rsi/research-lab

# Fixed Task Agent for mathematical and KernelBench Harness evaluation.
# Never borrowed from the research connection.
RSI_TARGET_BASE_URL=
RSI_TARGET_API_KEY=
RSI_TARGET_MODEL=

# LCB uses the account configured by `arena token set` / `arena doctor`.
# ARENA_PROFILE=prod

# Optional trusted Task Runtime JSON; archived when preparing mathematical research.
# RSI_RUNTIME_CONFIG=/absolute/path/examples/runtime/dsh.json
