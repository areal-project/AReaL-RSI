# Responses API connection. Keep the real key in the ignored .env file.
RSI_BASE_URL=https://api.openai.com/v1
RSI_API_KEY=
RSI_MODEL=gpt-6-astra
RSI_REASONING_EFFORT=high

# RSI owns a separate CODEX_HOME below this directory.
RSI_DATA_ROOT=.rsi

# Optional native Codex settings.
# RSI_CODEX_BIN=codex
# RSI_API_KEY_ENV=RSI_API_KEY
# Defaults allow access beyond the workspace without approval prompts.
RSI_SANDBOX=danger-full-access
RSI_APPROVAL_POLICY=never

# Optional runtime / local experience switches (1 = enabled).
# RSI_KEEP_AWAKE=1
# RSI_USE_EXPERIENCE=1
# 1 = automatic curation; 0 = wait for /learn and optional human feedback.
# Switch the current session with /learn-mode auto|guided.
# RSI_AUTO_LEARN=1
