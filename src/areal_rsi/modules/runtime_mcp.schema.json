{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["servers", "catalog"],
  "properties": {
    "servers": {
      "type": "array", "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["serverName", "transport", "command", "args", "cwd"],
        "properties": {
          "serverName": {"type": "string", "minLength": 1},
          "transport": {"const": "stdio"},
          "command": {"type": "string", "minLength": 1},
          "args": {"type": "array", "items": {"type": "string"}},
          "cwd": {"type": "string", "minLength": 1},
          "failOnStartupError": {"type": "boolean"}
        }
      }
    },
    "catalog": {
      "type": "array", "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["server", "tool", "spec"],
        "properties": {
          "server": {"type": "string", "minLength": 1},
          "tool": {"type": "string", "minLength": 1},
          "spec": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "description", "inputSchema", "permissions"],
            "properties": {
              "name": {"type": "string", "pattern": "^rsi_mcp_[0-9a-f]{20}$"},
              "description": {"type": "string"},
              "inputSchema": {"type": "object"},
              "permissions": {"type": "array", "items": {"enum": ["workspace.read", "workspace.write", "workspace.execute"]}}
            }
          }
        }
      }
    }
  }
}
