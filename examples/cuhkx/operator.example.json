{
  "prepared_data": "/absolute/path/to/cuhkx-prepared",
  "runner": {
    "kind": "docker",
    "image": "replace-with-your-installed-pytorch-image",
    "python": "python",
    "device": "cuda:0",
    "gpu_ids": ["0"],
    "cpus": 4,
    "memory": "8g",
    "pids_limit": 256
  },
  "training": {
    "timeout_seconds": 3600,
    "max_epochs": 10,
    "max_batch_size": 128,
    "max_frames": 16,
    "max_image_size": 224,
    "max_width": 128,
    "max_threads": 4,
    "defaults": {
      "epochs": 10,
      "batch_size": 8,
      "frames": 8,
      "image_size": 64,
      "width": 16,
      "learning_rate": 0.001,
      "seed": 42,
      "threads": 2
    }
  },
  "verification": {
    "timeout_seconds": 600,
    "device": "cuda:0",
    "batch_size": 8,
    "threads": 2
  },
  "phases": {
    "search": "validate",
    "diagnostic": "validate",
    "final": "final"
  }
}
