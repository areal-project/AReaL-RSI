# Default connection for interaction-agent, RSI Agent and ResearchAgents.
RSI_TEACHER_MODEL=
RSI_TEACHER_BASE_URL=
RSI_TEACHER_API_KEY=

# Target Model connection used directly by Task Agent and benchmark evaluation.
# Target credentials never fall back to teacher credentials.
RSI_TARGET_MODEL=
RSI_TARGET_BASE_URL=
RSI_TARGET_API_KEY=

# One data directory can contain experiments with different models.
RSI_DATA_ROOT=.rsi/local
RSI_BENCHMARK=arithmetic-v1
RSI_RESEARCH_AGENT_COUNT=1

# Optional overrides keyed by interaction-agent, rsi-agent or research-agent.
# model-only overrides inherit the default service. Use api_key_env to reference a local secret.
RSI_AGENT_MODELS={}
