      "command": "python3",
      "env_vars": [
        "RSI_CLI_HOME", "RSI_CLI_REF", "RSI_CLI_PATH", "RSI_CLI_REPOSITORY",
        "RSI_DATA_ROOT", "RSI_API_KEY", "RSI_MODEL", "RSI_REASONING_EFFORT",
