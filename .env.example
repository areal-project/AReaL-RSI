# Default connection for interaction-agent, RSI Agent and ResearchAgents.
RSI_TEACHER_MODEL=
RSI_TEACHER_BASE_URL=
RSI_TEACHER_API_KEY=

# Target Model connection used directly by Task Agent and benchmark evaluation.
# Target credentials never fall back to teacher credentials.
RSI_TARGET_MODEL=
RSI_TARGET_BASE_URL=
RSI_TARGET_API_KEY=

# Workspace root (default .rsi); each plan has an independent experiments/ subdirectory.
RSI_DATA_ROOT=
# Legacy non-interactive config paths. TUI selects a YAML/demo in rsi_plan instead.
RSI_LOCAL_CONFIG=
# Optional trusted local application factories; experiment YAML selects a registered backend.
# RSI_LOCAL_APPS={"custom":"your_package.entry:create_app"}
RSI_REMOTE_CONFIG=
RSI_RESEARCH_AGENT_COUNT=1

# Optional overrides keyed by interaction-agent, rsi-agent or research-agent.
# model-only overrides inherit the default service. Use api_key_env to reference a local secret.
RSI_AGENT_MODELS={}

# Optional absolute path to a trusted Runtime JSON config; empty selects DSH.
RSI_RUNTIME_CONFIG=

# Frontend DSH wire protocol: chat-completions or responses.
RSI_TUI_MODEL_API=chat-completions

# Maximum duration of one background Agent turn, in seconds.
RSI_TURN_TIMEOUT=1200

# Responses API connection for the new research/workbench commands.
# These agents keep the exact model and reasoning effort; GPU simulation still calls this API.
RSI_MODEL=gpt-6-astra
RSI_REASONING_EFFORT=xhigh
RSI_BASE_URL=https://api.openai.com
RSI_API_KEY=
