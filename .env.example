# TUI / Leader goal / legacy pass@k.
RSI_BASE_URL=https://4ipic.com
RSI_API_KEY=
RSI_MODEL=gpt-6-astra
RSI_REASONING_EFFORT=medium

# Target Model connection used directly by Task Agent and benchmark evaluation.
# Target credentials never fall back to teacher credentials.
RSI_TARGET_MODEL=
RSI_TARGET_BASE_URL=
RSI_TARGET_API_KEY=

# Research workspace root.
RSI_DATA_ROOT=.rsi/research-lab

# Automatically defaults to sandbox on macOS and linux-unrestricted on Linux.
# Linux agents run with the service user's permissions, without filesystem/process isolation.
# Optional override:
# RSI_RUNTIME_ISOLATION=sandbox
