# Web workbench / open research / KernelBench artifact demo.
RSI_BASE_URL=https://4ipic.com
RSI_API_KEY=
RSI_MODEL=gpt-5.6-luna
RSI_REASONING_EFFORT=xhigh

# Target Model connection used directly by Task Agent and benchmark evaluation.
# Target credentials never fall back to teacher credentials.
RSI_TARGET_MODEL=
RSI_TARGET_BASE_URL=
RSI_TARGET_API_KEY=

# Research workspace root.
RSI_DATA_ROOT=.rsi/research-lab

# Trusted Linux hosts only: linux-unrestricted runs agents with the service user's permissions.
# Default sandbox requires macOS sandbox-exec; Linux has no automatic fallback.
RSI_RUNTIME_ISOLATION=sandbox
